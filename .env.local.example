# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Both values are safe in the browser: row level security is what protects the
# data, and nothing is readable while signed out. .env.local is gitignored.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Labelled "Publishable key" (sb_publishable_...) on newer projects,
# "anon public" (a long JWT) on older ones. Either works.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# Do NOT put the service_role / secret key in this file or anywhere in the
# repo. The app never uses it — it bypasses row level security.
